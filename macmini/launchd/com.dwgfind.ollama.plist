<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dwgfind.ollama</string>
  <key>ProgramArguments</key>
  <array><string>/Applications/Ollama.app/Contents/Resources/ollama</string><string>serve</string></array>
  <key>UserName</key><string>__USER__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/__USER__</string>
    <key>OLLAMA_HOST</key><string>0.0.0.0:11434</string>
    <key>OLLAMA_MODELS</key><string>/Users/__USER__/.ollama/models</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>30m</string>
  </dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>LowPriorityIO</key><false/>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/__USER__/Library/Logs/dwgfind-ollama.log</string>
  <key>StandardErrorPath</key><string>/Users/__USER__/Library/Logs/dwgfind-ollama.log</string>
</dict>
</plist>
