# Mac mini 用の設定。 cp .env.example .env して値を埋める（.env は Git に入れない）
SERVER_URL=http://128.131.250.252:8000
WORKER_TOKEN=                 # Ubuntu の .env と同じ値
SOURCE_ROOT=smb://128.131.1.253/HOUSE設計
SMB_USER=
SMB_PASSWORD=
WORKER_CONCURRENCY=6          # 同時に解析するファイル数（M4 10コアのうち6）
SCAN_INTERVAL_MIN=60          # 巡回の間隔（分）
# 巡回する直下のフォルダ（2026-09-29 決定。対象外：写真・PDF temp file・Ricohｽｷｬﾅｰ・ダウンロード）
SCAN_INCLUDE=図面 DXF・DWG・JW・PDF,図面原紙・資料 PDF
SCAN_EXCLUDE=~$,/.Trash,/#recycle,/$RECYCLE.BIN
# 図番・品番の形（HB0001XXXX, HDBY003920, HUCP240054, HU90200000, 2665754013 などに一致）
DRAWING_NO_REGEX=[A-Z]{1,4}-?\d{3,8}(?:X{2,6})?(?:-\d{1,3})?[A-Z]?|(?<!\d)\d{10}(?!\d)
# 部品表の読み取り：DXF は常に行う。スキャン PDF（OCR）は精度を確かめてから 1 にする
BOM_PDF=0
